<sw-theme-toggle>
	<button type="button" class="sw-theme-toggle" aria-pressed="false">
		<svg class="to-dark" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" />
		</svg>
		<svg class="to-light" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
		</svg>
		<span class="sr-only">Dark theme</span>
	</button>
</sw-theme-toggle>

<script>
	const storageKey = 'starlight-theme';

	class SwThemeToggle extends HTMLElement {
		observer?: MutationObserver;
		controller?: AbortController;

		connectedCallback() {
			this.controller = new AbortController();
			const button = this.querySelector('button')!;
			const sync = () =>
				button.setAttribute(
					'aria-pressed',
					String(document.documentElement.dataset.theme === 'dark')
				);
			sync();
			// Header and mobile-menu controls observe the same theme state.
			this.observer = new MutationObserver(sync);
			this.observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['data-theme'],
			});
			button.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				const reveal = (window as any).SwThemeReveal;
				if (reveal) {
					// The template's circle reveal from this button; it stores the choice and sets html.dark.
					reveal.switchTheme(next, button, {
						storageKey,
						onApply: (dark: boolean) => {
							document.documentElement.dataset.theme = dark ? 'dark' : 'light';
							sync();
						},
					});
				} else {
					document.documentElement.dataset.theme = next;
					try {
						localStorage.setItem(storageKey, next);
					} catch {}
					sync();
				}
			}, { signal: this.controller.signal });
		}

		disconnectedCallback() {
			this.observer?.disconnect();
			this.controller?.abort();
		}
	}
	customElements.define('sw-theme-toggle', SwThemeToggle);
</script>

<style>
	/* Tokens only, one treatment in both themes: panel fill, control-outline boundary (3.0:1 or more against the
	   page in light, 4.7:1 or more in dark) and an ink icon. Light and dark are equals, so the dark theme is not
	   drawn as an "on" state: aria-pressed still tells assistive technology which theme is active, and the
	   sun/moon glyph shows it visually. v2.5.0 painted aria-pressed with the accent pair, which made the toggle a
	   teal chip in dark only, gave it a teal icon unlike every other header control, and hid hover in dark.
	   Hover darkens the boundary to ink so it is visible in both themes. */
	.sw-theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid rgb(var(--color-outline));
		border-radius: 999px;
		background: rgb(var(--color-panel));
		color: rgb(var(--color-ink));
		cursor: pointer;
		transition: background-color var(--sw-dur-fast, 120ms), border-color var(--sw-dur-fast, 120ms);
	}
	.sw-theme-toggle:hover {
		background: rgb(var(--color-hover));
		border-color: rgb(var(--color-ink));
	}
	/* During the circle reveal the new theme is a live snapshot: a colour transition here would draw the toggle
	   in the old theme's colours at the very point the circle grows from. Switch its colours with the page. */
	:global(html.sw-theme-reveal) .sw-theme-toggle {
		transition: none;
	}
	.sw-theme-toggle:focus-visible {
		outline: 2px solid rgb(var(--color-focus));
		outline-offset: 2px;
	}
	.sw-theme-toggle :global(svg) {
		width: 1.1rem;
		height: 1.1rem;
	}
	:global([data-theme='light']) .to-light,
	:global([data-theme='dark']) .to-dark {
		display: none;
	}
</style>
